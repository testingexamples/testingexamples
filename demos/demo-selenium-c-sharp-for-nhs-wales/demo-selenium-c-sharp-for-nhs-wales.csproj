<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>demo-selenium-c-sharp-for-nhs-wales</AssemblyName>
    <RootNamespace>Demo</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Joel Parker Henderson</Authors>
    <Description>Demo Selenium C# for NHS Wales</Description>
    <RepositoryUrl>https://github.com/testingexamples/demo-selenium-c-sharp-for-nhs-wales/</RepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="4.*" />
    <PackageReference Include="Selenium.Support" Version="4.*" />
  </ItemGroup>

</Project>
